{%- set PageName = page_name | pascal_case -%}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
</head>
<body>
    <h1>{{ title }}</h1>

    <!-- <ai:customize hint="Add content for the {{ page_name }} page"> -->
    <p>Welcome to the {{ title }} page.</p>
    <!-- </ai:customize> -->
</body>
</html>
