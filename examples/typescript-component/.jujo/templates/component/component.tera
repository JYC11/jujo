  async getAll(): Promise<I{{ ComponentName }}[]> {
    throw new Error("Not implemented");
  }

  async getById(id: string): Promise<I{{ ComponentName }}> {
    throw new Error("Not implemented");
  }
  // </ai:customize>
}
