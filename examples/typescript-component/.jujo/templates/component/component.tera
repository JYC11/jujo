{%- set ComponentName = component_name | pascal_case -%}
export interface I{{ ComponentName }} {
  id: string;
{%- for field in fields %}
{%- if field.nullable %}
  {{ field.name }}: {{ field.mapped_type }} | null;
{%- else %}
  {{ field.name }}: {{ field.mapped_type }};
{%- endif %}
{%- endfor %}
}

export class {{ ComponentName }}Service {
